# Copy to .env.test for running the automated test suite against a
# dedicated database (never reuse your dev database for tests).

DATABASE_URL="postgresql://wedding_app:wedding_app@localhost:5432/wedding_app_test?schema=public"
PORT=4001
NODE_ENV=test
JWT_ACCESS_SECRET="test-access-secret"
JWT_REFRESH_SECRET="test-refresh-secret"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
BACKEND_PUBLIC_URL="http://localhost:4001"

# Keeping RAZORPAY_KEY_ID prefixed "rzp_test_stub" selects the
# no-network StubPaymentProvider for the whole test suite (see
# backend/src/payments/index.ts) - the fixed secrets below let tests
# compute valid HMAC signatures the same way Razorpay/checkout.js would.
RAZORPAY_KEY_ID="rzp_test_stub_dev_only"
RAZORPAY_KEY_SECRET="test-stub-secret-for-signature-verification"
RAZORPAY_WEBHOOK_SECRET="test-stub-webhook-secret-for-signature-verification"
PLATFORM_COMMISSION_PERCENTAGE=10

REVIEW_AUTO_PUBLISH=false
