# Copy this file to .env and fill in real values for local development.
# Never commit the actual .env file.

# PostgreSQL connection string
DATABASE_URL="postgresql://wedding_app:wedding_app@localhost:5432/wedding_app?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT secrets - generate strong random values, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Frontend origin allowed by CORS
FRONTEND_URL="http://localhost:5173"

# Public origin this API is served from - used to build absolute URLs for
# uploaded files (e.g. vendor portfolio images). Change this to your real
# domain in production.
BACKEND_PUBLIC_URL="http://localhost:4000"

# Razorpay - https://dashboard.razorpay.com/app/keys (use TEST mode keys for
# local development, never live keys). Leave the values below as-is and the
# backend automatically falls back to an in-process StubPaymentProvider that
# needs no network access or real credentials - see "Payment setup" in the
# README for exactly what that does and doesn't cover. Fill in real
# rzp_test_... credentials to exercise the real Razorpay Checkout flow.
RAZORPAY_KEY_ID="rzp_test_stub_dev_only"
RAZORPAY_KEY_SECRET="stub_dev_secret_do_not_use_in_prod"
# From your Razorpay Dashboard's Webhooks settings when you add the
# /api/v1/payments/webhook/razorpay endpoint - see "Webhook setup" in the README.
RAZORPAY_WEBHOOK_SECRET="stub_dev_webhook_secret_do_not_use_in_prod"

# Whole-percent platform commission applied to every captured payment.
PLATFORM_COMMISSION_PERCENTAGE=10

REVIEW_AUTO_PUBLISH=false
